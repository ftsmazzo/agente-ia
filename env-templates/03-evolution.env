# =============================================================================
# SERVIÇO: Evolution API — EasyPanel → Environment
# A maior parte é configurada no PAINEL da instância (webhook, Chatwoot, apikey).
# Use este arquivo só para variáveis de CONTAINER Evolution.
# =============================================================================

# Obrigatório em alguns installs self-hosted:
CHATWOOT_ENABLED=true

# --- Normalmente no painel da instância (não duplique como env se já configurou na UI) ---
# Nome da instância WhatsApp
# Webhook POST: https://SEU-N8N/webhook/whatsapp-agent
# API Key da instância → copiar para n8n como EVOLUTION_API_KEY
#
# Integração Chatwoot (painel Evolution):
#   URL base Chatwoot
#   Account ID
#   Token do inbox
#   Conversation Pending = false (recomendado)

# --- NÃO PERTENCE A ESTE SERVIÇO (apague se estiver aqui) ---
# AGENT_API_URL
# AGENT_API_KEY
# API_INTERNAL_KEY
# DATABASE_URL
# OPENAI_API_KEY
# APPOINTMENT_NOTIFY_PHONE
