# =============================================================================
# SERVIÇO: n8n — EasyPanel → Environment
# Cole este bloco INTEIRO no serviço n8n. NÃO cole no agente-ia.
# =============================================================================

N8N_BLOCK_ENV_ACCESS_IN_NODE=false

AGENT_API_URL=http://agent-ia:3000
AGENT_API_KEY=

EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY=

DEBOUNCE_MS=5000

APPOINTMENT_NOTIFY_PHONE=
# Lembretes 24h e alertas de erro (workflow 06). Se vazio, usa APPOINTMENT_NOTIFY_PHONE.
OPS_NOTIFY_PHONE=

PUBLIC_AGENT_API_URL=
# URL pública do portal (link no lembrete de confirmação)
PORTAL_PUBLIC_URL=

CHATWOOT_INBOX_ID=

# --- Infra n8n (ajuste ao seu domínio EasyPanel) ---
# WEBHOOK_URL=https://n8n.seudominio.com
# N8N_HOST=n8n.seudominio.com
# N8N_PROTOCOL=https

# --- NÃO PERTENCE A ESTE SERVIÇO (apague se estiver aqui) ---
# API_INTERNAL_KEY          → use como AGENT_API_KEY (mesmo valor, nome diferente)
# DATABASE_URL
# REDIS_URL
# OPENAI_API_KEY
# RAG_API_KEY
# BRAND_NAME
# DEBOUNCE_MAX_WAIT_MS      → só na API
