# Serviço PORTAL no EasyPanel (frontend)
# Domínio: painel.seudominio.com

# OBRIGATÓRIO — Environment do container (runtime), não só Build Arg
# Mesma URL pública da API agente-ia (sem barra no final)
PORTAL_API_URL=https://assets-agent-ia.kxryyk.easypanel.host

# Opcional no build (se PORTAL_API_URL estiver setado, nao precisa)
# VITE_API_URL=https://assets-agent-ia.kxryyk.easypanel.host

# Na API (serviço agente-ia) — URL EXATA do painel (https, sem barra final)
# PORTAL_CORS_ORIGIN=https://painel.seudominio.com
