# =============================================================================
# SERVIÇO: agente-ia (API) — EasyPanel → Environment
# Cole este bloco INTEIRO no serviço da API. NÃO cole no n8n.
# Confronte linha a linha com o que já existe; apague duplicatas fora deste serviço.
# =============================================================================

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

BRAND_NAME=
BRAND_SLUG=
ASSISTANT_NAME=
ASSISTANT_TITLE=
BRAND_WEBSITE=
BRAND_PRIMARY_COLOR=
BRAND_LOGO_URL=
DEFAULT_LOCALE=pt-BR
TIMEZONE=America/Sao_Paulo

FEATURE_AUDIO_REPLY=true
FEATURE_SCHEDULING=true
FEATURE_PROPERTY_RAG=true
FEATURE_HUMAN_HANDOFF=true

SYSTEM_PROMPT_PATH=/app/config/prompts/system.pt-BR.md
PERSONA_PROMPT_PATH=/app/config/prompts/persona.pt-BR.md

DATABASE_URL=
REDIS_URL=

RUN_MIGRATIONS_ON_START=true
DB_WAIT_MAX_ATTEMPTS=30
DB_WAIT_DELAY_MS=2000

DEBOUNCE_MS=5000
DEBOUNCE_MAX_WAIT_MS=20000

RESET_DEV_DATA_ON_START=false
# Se NODE_ENV=production e quiser zerar tudo no restart:
# ALLOW_DEV_DATA_RESET=true

API_INTERNAL_KEY=

LLM_PROVIDER=openai
LLM_MODEL=
LLM_MAX_TOKENS=2500
CHAT_MAX_HISTORY_TURNS=8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GOOGLE_AI_API_KEY=

RAG_API_URL=
RAG_API_KEY=
RAG_KNOWLEDGE_BASE_ID=
RAG_TOP_K=5
RAG_TOP_K_CRITERIA=10
RAG_TIMEOUT_MS=45000

SENTRY_DSN=

# Endereço da imobiliária (confirmação ao cliente + alerta ao corretor)
APPOINTMENT_OFFICE_ADDRESS=
# Link Google Maps (cole o link curto ou completo; vai em linha separada no WhatsApp)
# Ex.: https://maps.google.com/?q=R.+Moreira+de+Oliveira,567,...
APPOINTMENT_OFFICE_MAPS_URL=
# URL pública HTTPS do serviço agente-ia (NÃO use subdomínio "assets" se for só estático)
# Teste: curl https://SEU-DOMINIO/health  →  {"status":"ok",...}
PUBLIC_AGENT_API_URL=

# Catálogo CSV (opcional no startup — ou importe pelo portal)
# CATALOG_IMPORT_ON_START=false
# CATALOG_CSV_PATH=/app/data/catalogo.csv

# Portal — login criado automaticamente no startup (sem curl)
PORTAL_JWT_SECRET=
PORTAL_CORS_ORIGIN=https://painel.seudominio.com
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_PASSWORD=
PORTAL_ADMIN_NAME=
# Opcional: login do cliente (agenda + agente)
PORTAL_CLIENT_EMAIL=
PORTAL_CLIENT_PASSWORD=
PORTAL_CLIENT_NAME=
# PORTAL_SEED_ON_START=true
# PORTAL_SYNC_PASSWORD_FROM_ENV=false

# --- NÃO PERTENCE A ESTE SERVIÇO (apague se estiver aqui) ---
# APPOINTMENT_NOTIFY_PHONE
# PUBLIC_AGENT_API_URL
# AGENT_API_URL
# AGENT_API_KEY
# WhatsApp (Evolution) — painel /whatsapp no portal
EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Opcional: exibir URL do webhook n8n no painel
# N8N_WHATSAPP_WEBHOOK_URL=https://SEU-N8N/webhook/whatsapp-agent
# CHATWOOT_BASE_URL
# CHATWOOT_ACCOUNT_ID
# CHATWOOT_API_TOKEN
# N8N_WEBHOOK_BASE_URL
# N8N_BLOCK_ENV_ACCESS_IN_NODE
# CHATWOOT_INBOX_ID
