# =============================================================================
# SERVIÇO: Postgres — EasyPanel → Environment (container PostgreSQL)
# A API conecta via DATABASE_URL, não via estas vars diretamente.
# =============================================================================

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=realty

# Montar na API (serviço agente-ia):
# DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/realty
# Troque "postgres" pelo hostname do serviço Postgres no EasyPanel.
