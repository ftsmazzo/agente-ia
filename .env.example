# =============================================================================
# Realty Agent Platform — deployment environment (white-label)
# Copy to .env locally or set in EasyPanel per client installation.
# NEVER commit real .env files with secrets.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Brand / white-label (required per deployment) ---
BRAND_NAME=Example Realty
BRAND_SLUG=example-realty
ASSISTANT_NAME=Assistant
ASSISTANT_TITLE=real estate consultant
BRAND_WEBSITE=https://www.example.com
BRAND_PRIMARY_COLOR=#1a5f4a
BRAND_LOGO_URL=
DEFAULT_LOCALE=pt-BR
TIMEZONE=America/Sao_Paulo

# --- Product features (toggle per deployment / plan) ---
FEATURE_AUDIO_REPLY=true
FEATURE_SCHEDULING=true
FEATURE_PROPERTY_RAG=true
FEATURE_HUMAN_HANDOFF=true

# --- Prompts ---
# Path inside container or mounted volume; use {{placeholders}} — see config/prompts/
SYSTEM_PROMPT_PATH=/app/config/prompts/system.pt-BR.md

# --- Data stores ---
DATABASE_URL=postgresql://realty:realty@localhost:5432/realty
REDIS_URL=redis://localhost:6379/0

# --- Migrations (automatic on container start) ---
RUN_MIGRATIONS_ON_START=true
DB_WAIT_MAX_ATTEMPTS=30
DB_WAIT_DELAY_MS=2000

# --- Dev: zerar Postgres + Redis no startup (desligue após o deploy de teste) ---
RESET_DEV_DATA_ON_START=false
# Se NODE_ENV=production no painel mas ainda é ambiente de testes:
# ALLOW_DEV_DATA_RESET=true

# --- Integrations (infrastructure services on EasyPanel) ---
EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_INSTANCE=
CHATWOOT_BASE_URL=http://chatwoot:3000
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
N8N_WEBHOOK_BASE_URL=http://n8n:5678

# --- Persona (SofIA / assistente) ---
SYSTEM_PROMPT_PATH=/app/config/prompts/system.pt-BR.md
PERSONA_PROMPT_PATH=/app/config/prompts/persona.pt-BR.md

# --- LLM: openai | anthropic ---
LLM_PROVIDER=openai
LLM_MODEL=
# GPT-5*: use >= 2500 (reasoning consome tokens antes do texto visível)
LLM_MAX_TOKENS=2500
CHAT_MAX_HISTORY_TURNS=8

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

GOOGLE_AI_API_KEY=

# --- RAG imóveis (https://rag.fabricadosdados.ia.br/api-docs) ---
RAG_API_URL=https://rag.fabricadosdados.ia.br
RAG_API_KEY=
RAG_KNOWLEDGE_BASE_ID=
RAG_TOP_K=5
# Busca por bairro/perfil: mínimo efetivo (chunks CSV grandes)
RAG_TOP_K_CRITERIA=10
RAG_TIMEOUT_MS=45000

# --- Security (API called by n8n only — use strong random in production) ---
API_INTERNAL_KEY=change-me-in-production

# --- Observability (optional) ---
SENTRY_DSN=
