# =============================================================================
# Realty Agent Platform — variáveis da API (agente-ia) APENAS
# EasyPanel: cole no serviço "agente-ia", NÃO no n8n/Evolution/Chatwoot inteiros.
# Mapa completo por serviço: docs/variaveis-por-servico.md
# n8n: veja n8n/env.easypanel.example
# =============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Brand / white-label (required) ---
BRAND_NAME=Example Realty
BRAND_SLUG=example-realty
ASSISTANT_NAME=Assistant
ASSISTANT_TITLE=real estate consultant
BRAND_WEBSITE=https://www.example.com
BRAND_PRIMARY_COLOR=#1a5f4a
BRAND_LOGO_URL=
DEFAULT_LOCALE=pt-BR
TIMEZONE=America/Sao_Paulo

# --- Product features ---
FEATURE_AUDIO_REPLY=true
FEATURE_SCHEDULING=true
FEATURE_PROPERTY_RAG=true
FEATURE_HUMAN_HANDOFF=true

# --- Prompts (paths inside container) ---
SYSTEM_PROMPT_PATH=/app/config/prompts/system.pt-BR.md
PERSONA_PROMPT_PATH=/app/config/prompts/persona.pt-BR.md

# --- Data stores ---
DATABASE_URL=postgresql://realty:realty@localhost:5432/realty
REDIS_URL=redis://localhost:6379/0

# --- Migrations (automatic on container start) ---
RUN_MIGRATIONS_ON_START=true
DB_WAIT_MAX_ATTEMPTS=30
DB_WAIT_DELAY_MS=2000

# --- Debounce WhatsApp (mesmo valor no n8n: DEBOUNCE_MS) ---
DEBOUNCE_MS=5000
DEBOUNCE_MAX_WAIT_MS=20000

# --- Dev: zerar Postgres + Redis no startup ---
RESET_DEV_DATA_ON_START=false
# Com NODE_ENV=production, o reset só roda se:
ALLOW_DEV_DATA_RESET=false

# --- Security: n8n envia como AGENT_API_KEY ---
API_INTERNAL_KEY=change-me-in-production

# --- LLM: openai | anthropic ---
LLM_PROVIDER=openai
LLM_MODEL=
LLM_MAX_TOKENS=2500
CHAT_MAX_HISTORY_TURNS=8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GOOGLE_AI_API_KEY=

# --- RAG imóveis ---
RAG_API_URL=https://rag.fabricadosdados.ia.br
RAG_API_KEY=
RAG_KNOWLEDGE_BASE_ID=
RAG_TOP_K=5
RAG_TOP_K_CRITERIA=10
RAG_TIMEOUT_MS=45000

# --- Observability (optional) ---
SENTRY_DSN=

# Endereço e Maps (confirmação + alerta de visita)
APPOINTMENT_OFFICE_ADDRESS=
APPOINTMENT_OFFICE_MAPS_URL=
PUBLIC_AGENT_API_URL=

# Catálogo de imóveis (planilha → Postgres no startup do container)
# Catálogo CSV genérico (opcional no startup)
CATALOG_IMPORT_ON_START=false
CATALOG_CSV_PATH=./data/catalogo.csv

# Portal (painel web) — usuários criados no startup a partir do env
PORTAL_JWT_SECRET=dev-portal-jwt-secret
PORTAL_CORS_ORIGIN=http://localhost:5173
PORTAL_ADMIN_EMAIL=admin@localhost
PORTAL_ADMIN_PASSWORD=admin-local-8
PORTAL_ADMIN_NAME=Admin Local
# PORTAL_CLIENT_EMAIL=
# PORTAL_CLIENT_PASSWORD=
# PORTAL_SYNC_PASSWORD_FROM_ENV=false

# =============================================================================
# NÃO são lidas pela API — configure no serviço indicado:
#   APPOINTMENT_NOTIFY_PHONE, PUBLIC_AGENT_API_URL  → n8n
#   EVOLUTION_*, CHATWOOT_*, N8N_WEBHOOK_*         → Evolution / Chatwoot / n8n
# Ver docs/variaveis-por-servico.md
# =============================================================================
