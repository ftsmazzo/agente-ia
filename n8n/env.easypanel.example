# Variáveis no serviço n8n (EasyPanel → Environment)
# Ajuste os hostnames aos nomes dos seus apps na mesma rede Docker.

# OBRIGATÓRIO para usar {{ $env.* }} no workflow (senão: "access to env vars denied")
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

AGENT_API_URL=http://agent-ia:3000
AGENT_API_KEY=<mesmo valor de API_INTERNAL_KEY da API>

EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY=<apikey da instância Evolution>

# Debounce — mesma janela que a API (ms). Várias mensagens seguidas → uma resposta.
DEBOUNCE_MS=5000

# Opcional — path do webhook (padrão no workflow: whatsapp-agent)
# WEBHOOK_PATH=whatsapp-agent

# Workflow 04-sync-chatwoot — só processar inbox SofIA (id numérico do Chatwoot)
# CHATWOOT_INBOX_ID=1

# Agenda própria — WhatsApp do corretor para receber alerta de visita agendada
# APPOINTMENT_NOTIFY_PHONE=5516999999999

# Opcional — domínio público da API para link .ics na notificação
# PUBLIC_AGENT_API_URL=https://agent-ia.seudominio.com
