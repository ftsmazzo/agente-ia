# Variáveis no serviço n8n (EasyPanel → Environment)
# Ajuste os hostnames aos nomes dos seus apps na mesma rede Docker.

AGENT_API_URL=http://agent-ia:3000
AGENT_API_KEY=<mesmo valor de API_INTERNAL_KEY da API>

EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY=<apikey da instância Evolution>

# Opcional — path do webhook (padrão no workflow: whatsapp-agent)
# WEBHOOK_PATH=whatsapp-agent
