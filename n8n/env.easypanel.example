# =============================================================================
# Variáveis do serviço n8n (EasyPanel → Environment)
# NÃO copie o .env.example da API aqui.
# Mapa completo: docs/variaveis-por-servico.md
# =============================================================================

# OBRIGATÓRIO — sem isso {{ $env.* }} falha nos workflows
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# API agente-ia (rede Docker — hostname do serviço no EasyPanel)
AGENT_API_URL=http://agent-ia:3000
AGENT_API_KEY=<mesmo valor de API_INTERNAL_KEY da API>

# Evolution
EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY=<apikey da instância Evolution>

# Debounce — MESMO valor da API
DEBOUNCE_MS=5000

# Agenda — alerta WhatsApp ao corretor (workflow 01)
APPOINTMENT_NOTIFY_PHONE=5516999999999

# URL pública HTTPS da API (link .ics na notificação; opcional)
# PUBLIC_AGENT_API_URL=https://agent-ia.seudominio.com

# Handoff Chatwoot — workflow 04-sync-chatwoot (opcional)
# CHATWOOT_INBOX_ID=1

# Infra n8n (configure no EasyPanel conforme seu domínio):
# WEBHOOK_URL=https://n8n.seudominio.com
# N8N_HOST=n8n.seudominio.com
