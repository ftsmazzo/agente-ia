    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst b = raw.body ?? raw;\nconst data = b.data ?? {};\nconst key = data.key ?? {};\nconst msg = data.message ?? {};\nconst remoteJid = String(key.remoteJid || '');\nconst phone = remoteJid.split('@')[0].replace(/\\D/g, '');\nconst text =\n  msg.conversation ||\n  msg.extendedTextMessage?.text ||\n  msg.imageMessage?.caption ||\n  '';\nconst pushName = String(\n  data.pushName || b.pushName || key.pushName || data.notifyName || ''\n).trim();\nconst evolutionUrl = String(b.server_url || $env.EVOLUTION_BASE_URL || '').replace(/\\/$/, '');\n\nreturn [\n  {\n    json: {\n      messageId: String(key.id || `${Date.now()}`),\n      phone,\n      message: text.trim() || '[sem texto]',\n      instance: String(b.instance || ''),\n      fromMe: key.fromMe === true,\n      isGroup: remoteJid.endsWith('@g.us'),\n      evolutionUrl,\n      pushName,\n      messageType: msg.audioMessage ? 'audio' : text ? 'text' : 'other',\n    },\n  },\n];"
      },
      "id": "a1000001-0001-4001-8001-000000000002",
